# ⚡ NPM Performance Optimizations
# Registry
registry=https://registry.npmjs.org/
@hookform:registry=https://registry.npmjs.org/

# GitHub packages (opcional)
#//npm.pkg.github.com/:_authToken=${GITHUB_TOKEN}
#@govindasystems:registry=https://npm.pkg.github.com

# 🚀 Performance: usar cache agressivo
prefer-offline=true
cache-min=9999999

# 🚀 Performance: instalações paralelas
maxsockets=50

# 🚀 Performance: não fazer audit automaticamente (economiza tempo)
audit=false

# 🚀 Performance: não fazer fund automaticamente
fund=false

# 🚀 Performance: logs reduzidos
loglevel=error

# 🚀 Performance: usar hardlinks quando possível
package-lock=true

# 🚀 Performance: não atualizar automaticamente
save-exact=false

# 🚀 Performance: progresso silencioso (mais rápido)
progress=false
