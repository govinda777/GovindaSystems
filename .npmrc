# ⚡ NPM Performance Optimizations - ROOT
# Este arquivo se aplica a todo o monorepo

# Registry
registry=https://registry.npmjs.org/

# 🚀 Performance: usar cache agressivo
prefer-offline=true
cache-min=9999999

# 🚀 Performance: instalações paralelas
maxsockets=50

# 🚀 Performance: não fazer audit automaticamente (economiza tempo)
audit=false

# 🚀 Performance: não fazer fund automaticamente
fund=false

# 🚀 Performance: logs reduzidos
loglevel=error

# 🚀 Performance: usar hardlinks quando possível
package-lock=true

# 🚀 Performance: progresso silencioso (mais rápido)
progress=false

# 🚀 Monorepo: hoisting de dependências
shamefully-hoist=true


